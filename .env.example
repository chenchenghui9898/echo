# Copy this file to .env.local and fill in your own key.
# Never commit .env.local or paste the key into browser-side code.
ECHO_DATA_BACKEND=json
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server/worker only. Prefer the current sb_secret_ key. Never prefix it with
# NEXT_PUBLIC_ and never expose it to browser code.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server-only model routing. Every specialized scenario falls back to the
# default model when its value is empty or omitted.
DEEPSEEK_MODEL_DEFAULT=deepseek-flash
# Classifies the intent of a human message in the public mood chat.
DEEPSEEK_MODEL_CHAT_INTENT=
# Generates public mood-chat messages from AI personas.
DEEPSEEK_MODEL_CHAT_REPLY=
# Analyzes a new viewpoint, diary entry, or work before comment scheduling.
DEEPSEEK_MODEL_CONTENT_ANALYSIS=
# Generates AI comments for posts and the comment laboratory.
DEEPSEEK_MODEL_COMMENT=
# Continues a persona's dialogue after a user agrees with or replies to a comment.
DEEPSEEK_MODEL_PERSONA_DIALOGUE=

# Generation settings are read only on the server and snapshotted per run.
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=2400
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_REQUEST_MAX_ATTEMPTS=2
DEEPSEEK_COMMENT_COUNT=5

# AI comment scheduler. Keep time scale at 1 in production.
ECHO_SCHEDULER_TIME_SCALE=1
ECHO_SCHEDULER_POLL_MS=5000
ECHO_SCHEDULER_CONCURRENCY=2
ECHO_SCHEDULER_MAX_RETRIES=3
ECHO_SCHEDULER_RETRY_BASE_MS=30000
ECHO_SCHEDULER_MAX_CYCLE_MS=43200000
# Optional in development; required to call the worker endpoint in production.
ECHO_WORKER_TOKEN=

# Public mood group-chat AI scheduler. Keep time scale at 1 in production.
ECHO_CHAT_AI_REPLY_PROBABILITY=0.9
ECHO_CHAT_AI_SECOND_REPLY_PROBABILITY=0.3
ECHO_CHAT_AI_DIRECT_REPLY_PROBABILITY=0.94
ECHO_CHAT_AI_FOLLOW_UP_PROBABILITY=0.15
ECHO_CHAT_AI_FIRST_DELAY_MIN_MS=5000
ECHO_CHAT_AI_FIRST_DELAY_MAX_MS=45000
ECHO_CHAT_AI_SECOND_DELAY_MIN_MS=10000
ECHO_CHAT_AI_SECOND_DELAY_MAX_MS=90000
ECHO_CHAT_AI_DIRECT_DELAY_MIN_MS=3000
ECHO_CHAT_AI_DIRECT_DELAY_MAX_MS=15000
ECHO_CHAT_AI_TIME_SCALE=1
ECHO_CHAT_AI_POLL_MS=1500
ECHO_CHAT_AI_CONCURRENCY=2
ECHO_CHAT_AI_MAX_RETRIES=3
ECHO_CHAT_AI_RETRY_BASE_MS=15000
ECHO_CHAT_AI_CONTEXT_MESSAGES=25
ECHO_CHAT_AI_MAX_CHAIN_DEPTH=3
ECHO_CHAT_AI_MAX_PENDING_TASKS=3
ECHO_CHAT_AI_MAX_RECENT_10=4
ECHO_CHAT_AI_MAX_SHARE_30=0.40
ECHO_CHAT_AI_MAX_CONSECUTIVE=3
ECHO_CHAT_AI_MIN_GLOBAL_INTERVAL_MS=12000
ECHO_CHAT_AI_INTENT_CONCURRENCY=2
ECHO_CHAT_AI_INTENT_MAX_RETRIES=2
ECHO_CHAT_AI_INTENT_RETRY_BASE_MS=5000
ECHO_CHAT_AI_HUMAN_CONVERSATION_FACTOR=0.55
ECHO_CHAT_AI_GROUP_QUESTION_BOOST=0.10
ECHO_CHAT_AI_INTENT_SEEKING_COMFORT=0.85
ECHO_CHAT_AI_INTENT_SEEKING_ADVICE=0.85
ECHO_CHAT_AI_INTENT_SHARING_FEELINGS=0.75
ECHO_CHAT_AI_INTENT_EXPRESSING_OPINION=0.75
ECHO_CHAT_AI_INTENT_ASKING_QUESTION=0.70
ECHO_CHAT_AI_INTENT_SHARING_EXPERIENCE=0.70
ECHO_CHAT_AI_INTENT_CASUAL_CHAT=0.45
ECHO_CHAT_AI_INTENT_SIMPLE_STATEMENT=0.15
ECHO_CHAT_AI_INTENT_ANNOUNCEMENT=0.10
